# Telegram — the @dopplercreatebot token; initData is signed with it
TELEGRAM_BOT_TOKEN=

# Supabase — read-only lookups of telegram_users → accounts
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public blog reads only (RLS allows published posts); same value as doppler-web's
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# doppler-web checkout (Revolut card / OxaPay crypto, promo pricing, webhooks)
DOPPLER_WEB_URL=https://www.dopplervpn.org
# Must equal CHECKOUT_SHARED_SECRET on the doppler-web (dopplervpn) Vercel project
CHECKOUT_SHARED_SECRET=
